# Set these as private environment variables in Render. Never commit real secrets.
FLASK_SECRET_KEY=replace-with-at-least-32-random-characters
ADMIN_PASSWORD=replace-with-a-long-unique-password
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Optional: manual Facebook Page publishing. Keep unset until Meta access is approved.
FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=
FB_GRAPH_VERSION=v27.0

# Optional persistent database path. Attach a Render disk before using a persistent path.
DATABASE_PATH=instance/nayadrishti.sqlite3
COOKIE_SECURE=true
LOG_LEVEL=INFO
